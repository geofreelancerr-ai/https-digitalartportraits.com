{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digital-art-portraits",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [
    { "binding": "DB", "database_name": "digital-art-portraits-orders", "database_id": "REPLACE_AFTER_CREATING_D1" }
  ],
  "r2_buckets": [
    { "binding": "RECEIPTS", "bucket_name": "digital-art-portraits-receipts" }
  ],
  "vars": {
    "MEDIA_ORIGIN": "https://artstore-c6jws2ww.manus.space"
  }
}
